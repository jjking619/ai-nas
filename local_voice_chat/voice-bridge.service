[Unit]
Description=Voice Bridge (KWS->ASR->OpenClaw->TTS)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__APP_DIR__/local_voice_chat
Environment=PYTHONUNBUFFERED=1
# PulseAudio 预加载库（录音必需；/etc/environment 里也配置了，但 systemd 服务默认不读取该文件）
Environment=LD_PRELOAD=/usr/lib/libpulse.so:/usr/lib/libpulse-mainloop-glib.so.0:/usr/lib/libpulse-mainloop-glib.so:/usr/lib/libpulse-simple.so:/usr/lib/pulseaudio/libpulsedsp.so:/usr/lib/pulseaudio/libpulsecommon-15.0.so:/usr/lib/pulseaudio/libpulsecore-15.0.so
Environment=PULSE_SERVER=unix:/run/pulse/native
ExecStart=__PYTHON_BIN__ __APP_DIR__/local_voice_chat/voice_bridge.py --http-mode --http-trigger-host 0.0.0.0 --http-trigger-port 28082 --wake-duration 4 --kws-root __VOICE_SDK_BASE__/kws1.0.0.1_SDK_16k_10ms_enwatermark_8h --asr-root __VOICE_SDK_BASE__/asr_cpu_1.19 --tts-root __VOICE_SDK_BASE__/tts_cpu_2.1 --wake-keyword-bin __VOICE_SDK_BASE__/kws1.0.0.1_SDK_16k_10ms_enwatermark_8h/res_shuffnet_v2/keyword_xiaoyuantongxue.bin --jellyfin-api-key 2dd04b84ab444fce831823a601b7b26d
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
